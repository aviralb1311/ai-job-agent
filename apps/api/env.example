# Copy to apps/api/.env for local development, or set these in the hosting dashboard.
PORT=4000
DATABASE_URL="file:./dev.db"
# PostgreSQL mode only: use Neon pooled DATABASE_URL at runtime and direct URL for migrations.
# DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require
# DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require
# Must exactly match the frontend origin, without a trailing slash.
CORS_ORIGIN=http://localhost:5173
# Optional: defaults to false outside production and true when NODE_ENV=production.
# Set AUTH_COOKIE_SECURE=true explicitly for production HTTPS if NODE_ENV is not set.
SESSION_TTL_DAYS=7
# Emails listed here receive the administrator role at registration.
ADMIN_EMAILS=
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
SOURCE_TIMEOUT_MS=12000
# Optional automatic full sync cadence in minutes; 0 disables scheduling.
SOURCE_SYNC_INTERVAL_MINUTES=0
