{
  "name": "@job-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "npm run db:generate:sqlite",
    "build": "npm run build:development",
    "build:compile": "tsc -p tsconfig.json",
    "build:development": "npm run db:generate:sqlite && npm run build:compile",
    "build:production": "npm run db:generate:postgresql && npm run build:compile",
    "start": "node dist/server.js",
    "test": "DATABASE_URL=file:./integration-test.db vitest run --config vitest.config.ts",
    "test:sqlite": "npm run test",
    "test:postgresql": "node scripts/run-postgresql-tests.mjs",
    "test:postgresql:guard": "node scripts/postgresql-test-url.test.mjs",
    "pretest": "npm run db:generate:sqlite && DATABASE_URL=file:./integration-test.db prisma db push --schema prisma/schema.prisma",
    "db:generate:sqlite": "prisma generate --schema prisma/schema.prisma",
    "db:generate:postgresql": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:migrate:dev:sqlite": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy:sqlite": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev:postgresql": "prisma migrate dev --schema prisma/postgresql/schema.prisma",
    "db:migrate:deploy:postgresql": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:push:sqlite": "prisma db push --schema prisma/schema.prisma",
    "check:prisma-schemas": "node scripts/check-prisma-schemas.mjs",
    "db:generate": "npm run db:generate:sqlite",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma --name init",
    "test:live-sources": "tsx src/jobs/connectors/live-smoke.ts",
    "test:catalog-live": "tsx src/jobs/catalog-live-smoke.ts",
    "db:push": "npm run db:push:sqlite"
  },
  "dependencies": {
    "@job-agent/shared": "0.1.0",
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^4.6.7",
    "pdfjs-dist": "4.7.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
