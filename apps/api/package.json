{
  "name": "@job-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "test:live-sources": "tsx src/jobs/connectors/live-smoke.ts",
    "test:catalog-live": "tsx src/jobs/catalog-live-smoke.ts",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@job-agent/shared": "0.1.0",
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
