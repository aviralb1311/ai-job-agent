{
  "manifest_version": 3,
  "name": "AI Job Agent - Application Helper",
  "version": "0.1.1",
  "description": "Recognises supported Greenhouse application forms.",
  "permissions": [],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://*.greenhouse.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Job Agent"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*"
      ],
      "js": [
        "greenhouse.js"
      ],
      "run_at": "document_idle"
    }
  ]
}