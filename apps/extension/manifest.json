{
  "manifest_version": 3,
  "name": "AI Job Agent - Application Helper",
  "version": "0.1.0",
  "description": "Recognises supported Greenhouse application forms. Profile autofill will be added in a later step.",
  "permissions": [],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://*.greenhouse.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*"
      ],
      "js": ["greenhouse.js"],
      "run_at": "document_idle"
    }
  ]
}